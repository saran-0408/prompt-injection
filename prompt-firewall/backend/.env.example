# =========================================================================
# Prompt Firewall — Backend Environment Configuration Template
# Copy this file to .env and configure for your environment.
# =========================================================================

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port
PORT=3000

# AI Provider Selection: 'mock' | 'gemini' | 'deepseek'
# 'mock' operates offline with simulated responses and requires no external API keys
AI_PROVIDER=mock

# Upstream Provider API Keys (Required only if AI_PROVIDER is set to gemini or deepseek)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional Model Override
# Defaults: gemini-2.5-flash for Gemini, deepseek-chat for DeepSeek, mock-llm-v1 for Mock
AI_MODEL=

# AI Request Timeout in milliseconds (default: 20000)
AI_REQUEST_TIMEOUT_MS=20000

# CORS Allowed Origins (Comma-separated list of trusted client origins)
# In production, this MUST NOT be '*' or contain localhost.
CORS_ORIGIN=http://localhost:5173

# Admin Dashboard Authentication Credentials
# In production, strong random values (at least 12 characters) must be configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_min_12_chars
ADMIN_API_KEY=your_secure_random_admin_api_key_here

# Audit Log Privacy Setting
# 'false' (default): user prompt message text is completely omitted from persistent audit logs.
# 'true': sanitized and redacted text previews are stored for compliance/moderation review.
AUDIT_STORE_MESSAGE_CONTENT=false

# SQLite Database File Path (Defaults to data/firewall.db)
DATABASE_PATH=

# Detection Thresholds (0 to 100)
DETECTOR_BLOCK_THRESHOLD=70
DETECTOR_REVIEW_THRESHOLD=40
DETECTOR_ENGINE=builtin

# Optional Member 2 External Detector Microservice Endpoint
# MEMBER2_DETECTOR_URL=http://localhost:8000/detect

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
